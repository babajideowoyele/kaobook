@article{misangyi_embracing_2017,
	title = {Embracing {Causal} {Complexity}: {The} {Emergence} of a {Neo}-{Configurational} {Perspective}},
	volume = {43},
	issn = {0149-2063, 1557-1211},
	shorttitle = {Embracing {Causal} {Complexity}},
	url = {http://journals.sagepub.com/doi/10.1177/0149206316679252},
	doi = {10.1177/0149206316679252},
	abstract = {Causal complexity has long been recognized as a ubiquitous feature underlying organizational phenomena, yet current theories and methodologies in management are for the most part not well-suited to its direct study. The introduction of the Qualitative Comparative Analysis (QCA) configurational approach has led to a reinvigoration of configurational theory that embraces causal complexity explicitly. We argue that the burgeoning research using QCA represents more than a novel methodology; it constitutes the emergence of a neo-configurational perspective to the study of management and organizations that enables a fine-grained conceptualization and empirical investigation of causal complexity through the logic of set theory. In this article, we identify four foundational elements that characterize this emerging neo-configurational perspective: (a) conceptualizing cases as set theoretic configurations, (b) calibrating cases’ memberships into sets, (c) viewing causality in terms of necessity and sufficiency relations between sets, and (d) conducting counterfactual analysis of unobserved configurations. We then present a comprehensive review of the use of QCA in management studies that aims to capture the evolution of the neo-configurational perspective among management scholars. We close with a discussion of a research agenda that can further this neo-configurational approach and thereby shift the attention of management research away from a focus on net effects and towards examining causal complexity.},
	language = {en},
	number = {1},
	urldate = {2023-12-03},
	journal = {Journal of Management},
	author = {Misangyi, Vilmos F. and Greckhamer, Thomas and Furnari, Santi and Fiss, Peer C. and Crilly, Donal and Aguilera, Ruth},
	month = jan,
	year = {2017},
	pages = {255--282},
	file = {Accepted Version:C\:\\Users\\Arena Box\\Desktop\\storage\\ZNWKR57Z\\Misangyi et al. - 2017 - Embracing Causal Complexity The Emergence of a Ne.pdf:application/pdf},
}
