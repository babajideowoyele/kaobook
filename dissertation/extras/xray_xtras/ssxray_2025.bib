	abstract = {Although recent scholarship has contributed to our understanding of sustainability transitions, more needs to be done to grasp the politics of these processes. What works and what does not work is being sorted out in the world of practical politics. But social science could contribute by drawing lessons from political experience and offering theoretical insights. © 2010 Elsevier B.V. All rights reserved.},
