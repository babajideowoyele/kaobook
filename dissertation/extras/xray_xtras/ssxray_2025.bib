@article{kaissling_morphology_1996,
	title = {Morphology of interstitial cells in the healthy kidney},
	volume = {193},
	issn = {1432-0568},
	url = {https://doi.org/10.1007/BF00186688},
	doi = {10.1007/BF00186688},
	abstract = {Renal interstitial cells play an important role in renal function and renal diseases. We describe the morphology of renal interstitial cells in the healthy kidney. We distinguish within the renal interstitium (1) renal fibroblasts and (2) cells of the immune system. Fibroblasts are in the majority and constitute the scaffold of the kidney; they are interconnected by junctions, and are attached to tubules and vessels. Although the phenotype of fibroblasts shows some variation depending on their location in the kidney and on their functional stage, their recognition as fibroblasts is possible on account of structural features. Among the cell types of the second group, antigen-presenting dendritic cells are the most abundant in in the peritubular interstitial spaces of healthy kidneys. Their incidence is highest in the inner stripe of the outer medulla. They share some morphological features with fibroblasts but lack others — junctional complexes, morphologically defined connections with tubules and vessels, and the prominent layer of actin filaments under the plasma membrane — that are characteristic for fibroblasts. Dendritic cells in healthy kidneys are morphologically different from macrophages, which are characterized by abundant primary and secondary lysosomes. In healthy kidneys macrophages are restricted to the connective tissue of the renal capsule and the pelvic wall, and to the periarterial connective tissue. Lymphocytes are rare in healthy kidneys. The distinction of cell types by morphology is supported by differences of membrane proteins. Among all interstitial cells in the renal cortex, fibroblasts alone exhibit ecto-5′-nucleotidase. Dendritic cells constitutively have a high abundance of MHC class II protein. Both proteins are mutually exclusive. Rat macrophages display the membrane antigen ED 2 and lymphocytes exhibit specific surface antigens, depending on their type and functional stage, e.g., CD4 or CD8.},
	language = {en},
	number = {4},
	urldate = {2023-12-01},
	journal = {Anat Embryol},
	author = {Kaissling, Brigitte and Hegyi, Ivan and Loffing, Johannes and Le Hir, Michel},
	month = apr,
	year = {1996},
	keywords = {Dendritic cells, Ecto-5′-nucleotidase, Fibroblasts, MHC class II},
	pages = {303--318},
	file = {Full Text PDF:C\:\\Users\\Arena Box\\Desktop\\storage\\N7YXSYNK\\Kaissling et al. - 1996 - Morphology of interstitial cells in the healthy ki.pdf:application/pdf},
}
@article{schilling_self-interstitial_1978,
	title = {Self-interstitial atoms in metals},
	volume = {69-70},
	issn = {0022-3115},
	url = {https://www.sciencedirect.com/science/article/pii/0022311578902611},
	doi = {10.1016/0022-3115(78)90261-1},
	abstract = {The present state of knowledge and understanding of the properties of self-interstitial atoms (SIAs) in metals is reviewed. Special emphasis is given to a discussion of the structure of SIAs and those properties which relate to structure such as relaxation volumes, elastic polarizabilities, defect vibrations, geometry of jump processes, and elastic interactions. The present experimental status with respect to these properties is summarized, and the basic theoretical concepts for their understanding are presented as simply as possible.
Résumé
L'état actuel de nos connaisances et de notre compréhension des propriétés des atomes autointerstitiels (S.I.A.) dans les métaux est passé en revue. L'accent est mis particulièrement sur une discussion relátive à la structure des atomes auto-interstitiels et de leurs propriétés qui sont reliées à la structure, telles que les volumes de relaxation, les polarisabilités élastiques, les vibrations de défauts, la géométrie des processus de saut, les interactions élastiques, etc. L'état actuel des faits expérimentaux concernant ces propriétés est résumé et les concepts théoriques fondamentaux pour leur compréhension sont présentés de manière aussi simple que possible.
Zusammenfassung
Im folgenden wird ein Überblick über den gegenwärtigen Stand der Kenntnisse der Eigenschaften von Eigenzwischengitteratomen in Metallen gegeben. Besonderes Gewicht wird auf die Diskussion der Struktur der Eigenzwischengitteratome gelegt und derjenigen Eigenschaften, die direkt damit zusammenhängen, wie Relaxationsvolumen, elastische Polarisierbarkeit, Schwingungsverhalten, Sprunggeometrie, elastische Wechselwirkung usw. Die zur Zeit verfügbaren experimentellen Informationen über diese Eigenschaften werden beschrieben, und die grundlegenden theoretischen Konzepte für das physikalische Verständnis dieser Eigenschaften werden in möglichst einfacher Form dargelegt.},
	urldate = {2023-12-01},
	journal = {Journal of Nuclear Materials},
	author = {Schilling, W.},
	month = feb,
	year = {1978},
	pages = {465--489},
	file = {ScienceDirect Full Text PDF:C\:\\Users\\Arena Box\\Desktop\\storage\\STY37EF8\\Schilling - 1978 - Self-interstitial atoms in metals.pdf:application/pdf;ScienceDirect Snapshot:C\:\\Users\\Arena Box\\Desktop\\storage\\X8CE5FUU\\0022311578902611.html:text/html},
}
