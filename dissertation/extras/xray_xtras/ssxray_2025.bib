	title = {Research frontiers for multi-system dynamics and deep transitions},
	volume = {41},
	issn = {22104224 (ISSN)},
	doi = {10.1016/j.eist.2021.10.025},
	abstract = {The sustainability transitions field has been dominated by studies on single systems. Expanding the scope to Deep Transitions involving interactions between a broad array of socio-technical systems opens up new research directions in three important domains: 1) areas of intervention; 2) transition justice; 3) accelerating actors. © 2021 Elsevier B.V.},
