	doi = {10.1016/B978-0-12-809467-9.00009-6},
	keywords = {Bacteria, Harpacticoids, Meiofauna, Nematodes, Oxygen, Protozoans, Reduced conditions},
	pages = {219--236},
}
@incollection{thorp_chapter_2011,
