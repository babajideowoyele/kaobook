	year = {2022},
	note = {Publisher: Springer Science and Business Media B.V.},
	keywords = {Literature review, LDA, Statistics, Research topics, Literature reviews, Performance analysis, Systematic Review, Computational literature review, Topic models, Football, Latent Dirichlet allocation, Machine learning approaches, Probabilistic topic models, Publication networks, Turing machines},
	pages = {1351--1371},
}
