%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% kaoci-rolebox.sty
% RoleBox Dissertation Custom Styling
%
% Custom colors, environments, and icons for the
% "Multimodal Cartography of Role Constellations" dissertation
%
% OVERVIEW
% --------
% This package provides dissertation-specific styling:
%   - RoleBox color palette (neutrals, brand, semantic, accents)
%   - FontAwesome5 icon shortcuts for data modalities
%   - tcolorbox environments for insights, methods, caveats, etc.
%   - Research question boxes (mainrq, subrq)
%   - Intermezzo support (unnumbered transitional sections)
%   - Table styling commands
%   - Custom chapter style
%   - Chapter divider images
%   - Citation placeholder (\needcite)
%
% USAGE
% -----
%   \usepackage{kaoci-rolebox}
%
% ENVIRONMENTS
% ------------
%   roleconceptbox  - Purple left border, for role concepts
%   insightbox      - Gold left border, for key findings (optional title)
%   methodbox       - Cyan left border, for methodology notes
%   databox         - Green left border, for data descriptions
%   caveatbox       - Coral left border, for warnings
%   criticalbox     - Coral with title, for important warnings
%   importantbox    - Purple outline, for key takeaways
%   chapteroverview - Green left border, italic, for chapter intros
%   summarybox      - Green shaded, for chapter summaries
%   propositionbox  - Purple outline, for theoretical propositions
%   pandaquote      - Styled quote block
%   mainrq          - Main research question (prominent)
%   subrq           - Sub research question (subtle)
%   roledef         - Definition box with optional title
%
% ICON COMMANDS
% -------------
%   Status:    \iconok, \iconwarn, \iconerr, \iconinfo, \iconidea, \iconnote
%   Modality:  \iconweb, \iconnews, \iconsocial, \iconvisual, \iconinvest, \iconbiblio, \iconwiki
%   Actors:    \iconorg, \iconnetwork, \icongov
%   Technical: \icongithub, \iconcode, \icondata, \iconui, \iconapi, \icontool
%   Method:    \iconnatural, \iconinterpret, \icondesign, \iconeval, \iconcomm
%   Navigation:\iconnext, \iconprev, \iconlink, \iconexternal
%
% COLORS
% ------
%   Neutrals: RBblack, RBcharcoal, RBcream
%   Brand:    RBdark, RBgold
%   Semantic: RBdata (blue), RBnature (green), RBwarn (gold), RBerror (coral)
%   Accents:  RBpurple, RBcyan, RBgreen, RBpink, RBteal
%
% OTHER COMMANDS
% --------------
%   \intermezzo{title}    - Start intermezzo section
%   \closeintermezzo      - End intermezzo, restore numbering
%   \chapterdivider{name} - Full-page image divider
%   \needcite{desc}       - Placeholder for missing citation
%   \role{text}           - Format role category
%   \actor{text}          - Format actor name
%   \concept{text}        - Format concept
%
% DEPENDENCIES
% ------------
%   xcolor, tikz, tcolorbox, fontawesome5, changepage
%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kaoci-rolebox}[2024/01/01 v1.0 RoleBox Dissertation Styling]

