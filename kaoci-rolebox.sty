%========================================================================================
% CHAPTER STYLE FOR ROLEBOX
%========================================================================================

% Custom chapter style with accent color
\DeclareDocumentCommand{\chapterstylerolebox}{}{%
    \renewcommand*{\chapterformat}{%
        \mbox{\color{AccentPurple}\chapappifchapterprefix{\nobreakspace}\scalebox{2.85}{\thechapter\autodot}}%
    }%
    \renewcommand\chapterlinesformat[3]{%
        \vspace{3.5\vscale}%
        \if@twoside%
            \Ifthispageodd{%
                \smash{\makebox[0pt][l]{%
                    \parbox[b]{\textwidth}{\flushright{\color{PandaCharcoal}##3}}%
                    \makebox[\marginparsep][c]{\color{AccentPurple}\rule[-2\vscale]{2pt}{27.4\vscale+\f@size mm}}%
                    \parbox[b]{\marginparwidth}{##2}%
                }}%
            }{%
                \smash{\makebox[\textwidth][r]{%
                    \parbox[b]{\marginparwidth}{\flushright{##2}}%
                    \makebox[\marginparsep][c]{\color{AccentPurple}\rule[-2\vscale]{2pt}{27.4\vscale+\f@size mm}}%
                    \parbox[b]{\textwidth}{\flushleft{\color{PandaCharcoal}##3}}%
                }}%
            }%
        \else%
            \smash{\makebox[0pt][l]{%
                \parbox[b]{\textwidth}{\flushright{\color{PandaCharcoal}##3}}%
                \makebox[\marginparsep][c]{\color{AccentPurple}\rule[-2\vscale]{2pt}{27.4\vscale+\f@size mm}}%
                \parbox[b]{\marginparwidth}{##2}%
            }}%
        \fi%
    }%
    \RedeclareSectionCommand[beforeskip=0cm,afterskip=10\vscale]{chapter}%
    \setlength{\mtocshift}{-3.5\vscale}%
}

