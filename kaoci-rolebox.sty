%========================================================================================
% INTERMEZZO COMMAND
%========================================================================================

% Counter for intermezzo pages (tracks pages used by intermezzos)
\newcounter{intermezzopages}
\newcounter{savedpage}

% Save original sidenote format for restoration
\newcounter{savedsidenote}

% Intermezzo - special unnumbered chapters between main chapters
% These are "stealth" sections:
%   - Roman numeral page numbers (separate from main content)
%   - Appear in TOC at a lower level (not as chapters)
%   - Don't count toward main page numbering
%   - Have their own running headers (not the previous chapter's)
%   - Use symbol marks for sidenotes (*, †, ‡, etc.) instead of numbers
\newcounter{savedtocdepth}
\newcommand{\intermezzo}[1]{%
    \cleardoublepage
    % Save current page number and switch to roman numerals for intermezzo
    \setcounter{savedpage}{\value{page}}%
    \pagenumbering{roman}%
    \setcounter{page}{1}%
    %
    % Save TOC depth and set to -1 to suppress all section entries in TOC
    \setcounter{savedtocdepth}{\value{tocdepth}}%
    \setcounter{tocdepth}{-1}%
    %
    % Switch sidenotes to use symbols instead of numbers
    \setcounter{savedsidenote}{\value{sidenote}}%
    \setcounter{sidenote}{0}%
    \renewcommand{\thesidenote}{\fnsymbol{sidenote}}%
    %
    % Set running headers for this intermezzo (KOMA-Script)
    \markleft{Intermezzo: #1}%
    \markright{Intermezzo: #1}%
    %
    \thispagestyle{empty}%
    \vspace*{2.5cm}
    \begin{center}
        {\color{AccentPurple}\rule{2cm}{2pt}}\\[0.8cm]
        {\Large\scshape\color{Slate} Intermezzo}\\[0.4cm]
        {\LARGE\bfseries\sffamily\color{PandaCharcoal} #1}\\[0.8cm]
        {\color{AccentPurple}\rule{2cm}{2pt}}
    \end{center}
    \vspace{1.5cm}
    % Add to TOC as a special entry (indented, italic, at chapter level but unnumbered)
    \addtocontents{toc}{\protect\vspace{0.3em}}%
    \addtocontents{toc}{\protect\contentsline{chapter}{\protect\numberline{}\protect\textit{Intermezzo: #1}}{\thepage}{}}%
    \addtocontents{toc}{\protect\vspace{0.3em}}%
}

% Command to end intermezzo and restore page numbering
\newcommand{\closeintermezzo}{%
    \cleardoublepage
    % Restore TOC depth
    \setcounter{tocdepth}{\value{savedtocdepth}}%
    %
    % Restore arabic sidenote numbering
    \renewcommand{\thesidenote}{\arabic{sidenote}}%
    \setcounter{sidenote}{\value{savedsidenote}}%
    %
    \pagenumbering{arabic}%
    \setcounter{page}{\value{savedpage}}%
}

