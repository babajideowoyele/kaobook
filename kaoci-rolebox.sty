%========================================================================================
% CHAPTER DIVIDERS
%========================================================================================
% Full-page divider image before chapters
% Usage: \chapterdivider{ch1-introduction} (without extension)
% Images should be in dividers/images/ folder as PNG files
% Set size with \chapterdividerwidth (default: full page width including margin)
\newlength{\chapterdividerwidth}
\setlength{\chapterdividerwidth}{\textwidth}
\addtolength{\chapterdividerwidth}{\marginparsep}
\addtolength{\chapterdividerwidth}{\marginparwidth}

% Simple centered divider with fixed equal margins (2cm each side)
\newcommand{\chapterdivider}[1]{%
    \clearpage
    \thispagestyle{empty}%
    \begin{tikzpicture}[remember picture,overlay]
        \node[anchor=center] at (current page.center) {%
            \includegraphics[width=\paperwidth-4cm,keepaspectratio]{#1.png}%
        };
    \end{tikzpicture}%
    \null
    \clearpage
}

%========================================================================================
% WIDE TABLE ENVIRONMENT
%========================================================================================
% For tables that need to extend into the margin
% Usage: \begin{widetable}{caption}{label}...\end{widetable}
% Or use table* environment directly for more control

% Simple wide tabular wrapper - extends into margin
\newenvironment{wideblock}{%
    \begin{adjustwidth}{0pt}{-\marginparwidth-\marginparsep}%
}{%
    \end{adjustwidth}%
}

% Calculate full width including margin
\newlength{\fulltextwidth}
\setlength{\fulltextwidth}{\textwidth}
\addtolength{\fulltextwidth}{\marginparsep}
\addtolength{\fulltextwidth}{\marginparwidth}

%========================================================================================
% PLACEHOLDER CITATIONS
%========================================================================================
% Use \needcite{description} to mark sentences that need citations.
% Shows [?] in red in the PDF and generates a warning in the log.
% Easy to search: grep -r "needcite" dissertation/
% Example: Intermediaries play a crucial role in transitions \needcite{intermediary-role}.

\makeatletter
\newcommand{\needcite}[1]{%
  \textcolor{red}{[?]}%
  \@latex@warning{Citation needed: #1}%
}

% Alternative: shows the description in margin (useful during drafting)
\newcommand{\needcitemargin}[1]{%
  \textcolor{red}{[?]}%
  \marginnote{\textcolor{red}{\scriptsize CITE: #1}}%
  \@latex@warning{Citation needed: #1}%
}
\makeatother

