@incollection{oliveira_multimodal_2017,
	series = {Research in the {Sociology} of {Organizations}},
	title = {Multimodal {Imaginaries} and the “{Big} {Worm}”: {Materialities}, {Artefacts} and {Analogies} in {São} {Paulo}’s {Urban} {Renovation}},
	volume = {54A},
	isbn = {978-1-78743-330-4 978-1-78743-329-8},
	url = {https://doi.org/10.1108/S0733-558X2017000054A002},
	abstract = {Recent interest in the multimodal accomplishment of organization has focused on the material and symbolic aspects of materiality. We argue that current literature invokes diverse “multimodal imaginaries,” that is, ways of conceiving the relation between the material and the conceptual, and that the different imaginaries support a plurality of perspectives on materiality. Using the empirical case of a large urban renewal project in São Paulo, Brazil, we illustrate three different multimodal imaginaries – the concrete, the semiotic, and the mimetic – and indicate how each imaginary determines the way in which the site in question is discursively constructed. After outlining the different approaches, we discuss their theoretical implications, advantages, and constraints, setting an agenda for future studies of materiality in organizational and institutional contexts.},
	urldate = {2023-12-07},
	booktitle = {Multimodality, {Meaning}, and {Institutions}},
	publisher = {Emerald Publishing Limited},
