	keywords = {Sustainable development, Regional development, Regional planning, Sustainability transitions, Transition management, Innovation policies, Innovation policy, Societal transitions, Regional innovation policy, Regional sustainability, Sustainable regional development, Systems theory, Experimental governance, Exploratory case studies, Gippsland , Australia, Smart Specialisation},
