	annote = {Export Date: 01 July 2025; Cited By: 37; Correspondence Address: K.R. Abbasi; Department of Business Administration, Faculty of Management Sciences, ILMA University, Karachi, Pakistan; email: kashifabbasi@shu.edu.cn},
}

@article{khmara_degrowth_2020,
	title = {Degrowth in the context of sustainability transitions: {In} search of a common ground},
	volume = {267},
	issn = {09596526 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85084952266&doi=10.1016%2fj.jclepro.2020.122072&partnerID=40&md5=2a188ed8cd80225e218b16448406ebac},
	doi = {10.1016/j.jclepro.2020.122072},
	abstract = {The aim of this article is to study how the sustainability transitions analytical framework can help to make other concepts of sustainable socio-economic development more specific and operational. Specifically, we investigate the linkages between sustainability transitions and degrowth. Based on a literature review of both degrowth and sustainability transitions, we distinguish several aspects that provide a common ground for both approaches. We identify degrowth as one of the most far-reaching forms of sustainability transitions but suggest that it would benefit from a more stringent conceptualization using the analytical framework of sustainability transitions. To this end, we apply some conceptual notions from sustainability transitions theory to describe the idea of a degrowth transition. In particular, we analyze two case studies of degrowth practices (Cargonomia and a Transition Towns network) using the analytical framework of transition experiments. Sustainability transitions analytical frameworks and conceptual notions proved to be helpful interpretative lenses for looking at degrowth, and they can help to systematically structure its main postulates. © 2020 The Authors},
	language = {English},
	journal = {J. Clean. Prod.},
	author = {Khmara, Y. and Kronenberg, J.},
	year = {2020},
	note = {Publisher: Elsevier Ltd},
	keywords = {Economics, Sustainable development, Literature reviews, Case-studies, Sustainability transition, Transition management, Regime, Transition experiment, Niche, Common ground, Degrowth, Degrowth practices, Landscape, Socio-economic development},
	annote = {Export Date: 01 July 2025; Cited By: 37; Correspondence Address: Y. Khmara; University of Lodz, Faculty of Economics and Sociology, Lodz, P.O.W. 3/5, 90-255, Poland; email: yaryna.khmara@uni.lodz.pl; CODEN: JCROE},
}

