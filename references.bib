	pages = {333--347},
	annote = {Export Date: 01 July 2025; Cited By: 20; Correspondence Address: W.P.C. Boon; Faculty of Geosciences, Utrecht University, CS Utrecht, Heidelberglaan 2, NL-3584, Netherlands; email: w.p.c.boon@uu.nl},
}

@article{xu_analyzing_2023,
	title = {Analyzing the factors contribute to achieving sustainable development goals in {Pakistan}: {A} novel policy framework},
	volume = {45},
	issn = {2211467X (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85145264671&doi=10.1016%2fj.esr.2022.101050&partnerID=40&md5=f0fa463c1a3be9b83d77688e108411d1},
	doi = {10.1016/j.esr.2022.101050},
	abstract = {Pakistan is in a terrifying and devastating energy crisis. Recently, the prediction for energy consumption has intensified compared to its production capacity, which is problematic for Pakistan's social and economic stability. Hence, it is vital to examine the link between power consumption, power prices, urban transition, other electricity use, and economic expansion from 1970 to 2018 in Pakistan. For analysis, the second-generation econometric technique of Lee and Strazicich (2013), novel Augmented Autoregressive Distributed Lag (AARDL), and Frequency Domain Causality (FDC) is useful to detect the long-medium and short-run association among the variables. The results show that power consumption stimulates economic expansion in the short and long-run, though the rise in power prices declines economic activity in the short and long-run. Also, urban transition and other electricity use are a substantial positive and negative impact on economic expansion in the short and long-run. The outcome suggests that efficient energy supply, low-cost power prices, proper urban transition management, and other energy use could be useful for policymakers to achieve SDGs 7 and 11 in Pakistan. © 2022 The Authors},
	language = {English},
	journal = {Energy Strateg. Rev.},
