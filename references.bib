}

@article{zhao_towards_2016,
	title = {Towards a {Semiotic} {Theory} of ({Proto}-){Institutionalization}},
	volume = {2016},
	issn = {0065-0668},
	url = {https://journals.aom.org/doi/10.5465/ambpp.2016.12875abstract},
	doi = {10.5465/ambpp.2016.12875abstract},
	abstract = {Institutionalization is a central yet elusive process in institution theory. While macro-institutionalization has been extensively studied, and studies of its micro-counterpart on the rise, efforts to promote a framework that bridges these two remain scarce. From a Peircean semiotic perspective, we theorize the process of institution emergence as changes in the triadic relations among Object, Representamen and Interpretant, associated with individual’s semiotic experiences nurtured by contextual information flows of distinctive nature and directions. Based on Peirce’s class of signs or semiotic categories, we offer a detailed semiotic model of institutionalization, from null institution to proto-institution then to institution, where the emergence is associated with the different semiotic categories into which the candidate institution evolves. We illustrate our framework with the proto-institutionalization of the red square, a visual-material artifact that has been mobilized repeatedly in the recent history of Québec, Canada and has been spreading beyond its national and geographical boundaries.},
	number = {1},
	urldate = {2023-12-07},
	journal = {Proceedings},
	author = {Zhao, Wenyao Will},
	month = jan,
	year = {2016},
	note = {Publisher: Academy of Management},
	pages = {12875},
}

@article{li_semiotic_2014,
	title = {A {Semiotic} {Perspective} on {Decoupling} and {Institutionalization}},
	volume = {2014},
	issn = {0065-0668},
	url = {https://journals.aom.org/doi/10.5465/ambpp.2014.12758abstract},
	doi = {10.5465/ambpp.2014.12758abstract},
	abstract = {I use semiotics to examine the meaning of two central concepts of institutional theory: decoupling and institutionalization. I argue that the ideas of decoupling and institutionalization initially articulated by Meyer and Rowan (1977) have been largely misused due to a lack of conceptual clarity in the understanding of the symbolic. I use semiotics to distinguish between two dimensions of the symbolic aspect of institutions: the signifier and the signified. Based on this new conception, it can be seen that decoupling not only occurs between words and action, as previous studies assume, but also between words and meaning as well as between literal, definitional meaning and metaphorical, implicative meaning. These different types of decoupling produce variations in the process of institutionalization. I propose to reconceptualize the institutionalization process as the coevolution of the material practice, the signifier, and the signified. I theorize first-order institutionalization as the process of tight coupling between the material and the symbolic, and second-order institutionalization as the evolution of second-order significations whereby the sign acquires new, connotative meanings. I develop several propositions about how the operations of the sign system influence the process of institutionalization, and I sketch stylized scenarios for different patterns of the coevolution.},
	number = {1},
	urldate = {2023-12-07},
	journal = {Proceedings},
	author = {Li, Yuan},
	month = jan,
	year = {2014},
	note = {Publisher: Academy of Management},
	pages = {12758},
}

