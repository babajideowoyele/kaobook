	pages = {1--21},
	file = {Full Text PDF:C\:\\Users\\babaj\\Zotero\\storage\\UZRDUHZQ\\Capurro and Severo - 2023 - Mapping European Digital Heritage Politics An Emp.pdf:application/pdf},
}

@article{blanke_network_2022,
	title = {A network view on reliability: using machine learning to understand how we assess news websites},
	volume = {5},
	issn = {2432-2725},
	shorttitle = {A network view on reliability},
	url = {https://doi.org/10.1007/s42001-021-00116-w},
	doi = {10.1007/s42001-021-00116-w},
	abstract = {This article shows how a machine can employ a network view to reason about complex social relations of news reliability. Such a network view promises a topic-agnostic perspective that can be a useful hint on reliability trends and their heterogeneous assumptions. In our analysis, we depart from the ever-growing numbers of papers trying to find machine learning algorithms to predict the reliability of news and focus instead on using machine reasoning to understand the structure of news networks by comparing it with our human judgements. Understanding and representing news networks is not easy, not only because they can be extremely vast but also because they are shaped by several overlapping network dynamics. We present a machine learning approach to analyse what constitutes reliable news from the view of a network. Our aim is to machine-read a network’s understanding of news reliability. To analyse real-life news sites, we used the Décodex dataset to train machine learning models from the structure of the underlying network. We then employ the models to draw conclusions how the Décodex evaluators came to assess the reliability of news.},
	language = {en},
	number = {1},
	urldate = {2023-12-07},
	journal = {J Comput Soc Sc},
	author = {Blanke, Tobias and Venturini, Tommaso},
	month = may,
	year = {2022},
	pages = {69--88},
	file = {Full Text PDF:C\:\\Users\\babaj\\Zotero\\storage\\A397PAPW\\Blanke and Venturini - 2022 - A network view on reliability using machine learn.pdf:application/pdf},
}

