@article{de_gooyert_sustainability_2016,
	title = {Sustainability transition dynamics: {Towards} overcoming policy resistance},
	volume = {111},
	issn = {00401625 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84977489306&doi=10.1016%2fj.techfore.2016.06.019&partnerID=40&md5=96a35b52fc4903111327b06c7d2d2776},
	doi = {10.1016/j.techfore.2016.06.019},
	abstract = {Sustainability transitions receive major scholarly attention, often explicitly with the intention to develop policy recommendations aimed towards progressing such transitions. Despite these efforts, many implemented transition policies have not been able to meet expectations. This tendency of systems to defeat the policies that have been designed to improve them is known as ‘policy resistance’. This paper addresses the question how we can explain the persistence of policy resistance in the context of sustainability transitions, and aims to bring us a step further in the direction of identifying policies that support overcoming policy resistance. System dynamics is an approach that explicitly addresses policy resistance and we investigate how this approach complements existing transition approaches. As an illustration, we apply the approach to the case of the Dutch energy transition, with the participation of 96 experts. We conclude that system dynamics complements the dominant multi-level perspective and the transition management approach by providing a middle ground between emphasizing agency or structure. Moreover, the approach helps overcoming policy resistance by mapping out the structure of the system responsible for policy resistance, thereby enabling the identification of high leverage points that support sustainability transitions. © 2016 Elsevier Inc.},
	language = {English},
	journal = {Technol. Forecast. Soc. Change},
	author = {de Gooyert, V. and Rouwette, E. and van Kranenburg, H. and Freeman, E. and van Breen, H.},
	year = {2016},
	note = {Publisher: Elsevier Inc.},
	keywords = {sustainability, Policy recommendations, Sustainable development, Energy transitions, Sustainability transition, Multilevels, Transition management, Netherlands, feedback mechanism, Leverage points, policy reform, Policy resistance, System Dynamics, System theory, systems analysis, Systems dynamics},
	pages = {135--145},
	annote = {Export Date: 01 July 2025; Cited By: 87; Correspondence Address: V. de Gooyert; Institute for Management Research, Radboud University, Nijmegen, P.O. Box 9108, 6500, Netherlands; email: v.de.gooyert@fm.ru.nl},
}

@article{polzin_addressing_2016,
