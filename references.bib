	note = {Publisher: Emerald Group Publishing Ltd.},
	keywords = {Education, Governance, Transition management, Lifelong learning},
	pages = {48--58},
	annote = {Export Date: 01 July 2025; Cited By: 11; Correspondence Address: V. Orlović-Lovren; DAI, Belgrade, Serbia; email: violeta\_o@yahoo.com},
