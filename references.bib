	isbn = {978-1-78756-081-9 978-1-78756-080-2},
	url = {https://doi.org/10.1108/S0733-558X20190000058012},
	abstract = {This study examines the legal codification of nascent markets, specifically, the process of defining and incorporating Islamic banking and organic agriculture within the legal system in Turkey. I find that actors’ priorities differ significantly with respect to formal codification and that the existing legal order and socio-political and economic contexts shape how state and non-state actors influence legislative and regulative action. This study contributes to our understanding of how actors and their ideological commitments and relational concerns affect the legal formulation of new industries.},
	urldate = {2023-12-07},
