	keywords = {Industrial engineering, Production engineering, Circular economy, Sustainability transition, Sustainability transitions, Eco-innovation, Eco-innovation intermediaries, Impact assessment, Impact assessments, Intermediation, Transfer functions},
	pages = {1136--1148},
