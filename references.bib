}

@article{clarke_engaging_2014,
	title = {Engaging {Complexities}: {Working} {Against} {Simplification} as an {Agenda} for {Qualitative} {Research} {Today}. {Adele} {Clarke} in {Conversation} {With} {Reiner} {Keller}},
