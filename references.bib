	volume = {103},
	issn = {00401625 (ISSN)},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-84949033857&doi=10.1016%2fj.techfore.2015.10.001&partnerID=40&md5=9c88292bd52f5f29235f4cc1f832d85e},
