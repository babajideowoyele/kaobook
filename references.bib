	month = jan,
	year = {2019},
	doi = {10.1108/S0733-558X20190000058011},
	pages = {187--208},
}

@incollection{mizrahi-shtelman_school_2019,
	series = {Research in the {Sociology} of {Organizations}},
	title = {School {Principals} as {Agents}: {Autonomy}, {Embeddedness}, and {Script}},
	volume = {58},
	isbn = {978-1-78756-081-9 978-1-78756-080-2},
	url = {https://doi.org/10.1108/S0733-558X20190000058005},
	abstract = {Ongoing discussions of the paradox of embedded agency may benefit from considering embedded agency from the perspective of the actors themselves. Drawing upon opinions of school principals who are encouraged to take initiative in their spheres of authority and yet still are subject to centralized performance assessments, the author redefines embedded agency as a matter of orientation. Secondly, the author presents a new typology for the notion of embedded agency and the way it is practiced in daily life. Finally, the author considers the tension that is inherent to the modern workplace, which is agentic and yet highly structured. From the perspective of school principals, the author shows how the professional role identity of mid-level managers is scripted and thus dictates the domains in which they can present a sense of agency.},
	urldate = {2023-12-07},
	booktitle = {Agents, {Actors}, {Actorhood}: {Institutional} {Perspectives} on the {Nature} of {Agency}, {Action}, and {Authority}},
	publisher = {Emerald Publishing Limited},
