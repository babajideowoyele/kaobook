@incollection{kohler_modelling_2019,
	title = {Modelling the multi-level perspective: {The} {MATISSE} agent-based model},
	isbn = {978-0-429-05657-4},
	shorttitle = {Modelling the multi-level perspective},
	abstract = {This chapter describes the way in which the MATISSE model was developed to implement the MLP framework for analysing transitions. Two applications, a transition to households’ sustainable mobility and a transition to low-emissions shipping, are illustrated. These two examples involve different interpretations of what a regime or a niche are. The sustainable mobility case looks at households’ choice of mobility lifestyles, involving not just transport modes, but also the geography of town planning, ways to reduce transport demand and attitudes towards public and private ownership of transport. The low-emissions shipping case involves a technology transition, although operational aspects of shipping are also considered. Therefore, the MATISSE structure has been shown to be adaptable to different cases.},
