@misc{meunier_minivan_2018,
	title = {{MiniVan}},
	url = {https://medialab.sciencespo.fr/en/tools},
	abstract = {{\textless}p{\textgreater}MiniVan is an application enabling users to publish a network on the web in order to let anyone explore it.{\textless}/p{\textgreater}{\textless}div class="vignette container\_vignette-block"{\textgreater}
              {\textless}input type="checkbox" id="focus-figure-1" name="focus-figure" hidden /{\textgreater}
              {\textless}label for="focus-figure-1" title="" arial-label=""{\textgreater}{\textless}/label{\textgreater}
              {\textless}figure class="vignette-block"{\textgreater}
                {\textless}img src="/static/minivan-map\_2d545ed2-d82a-4aad-9b5a-ad8a0ac8949c.png" alt="View showing the graph's basemap"/{\textgreater}{\textless}figcaption{\textgreater}View showing the graph's basemap{\textless}/figcaption{\textgreater}
              {\textless}/figure{\textgreater}
            {\textless}/div{\textgreater}{\textless}p{\textgreater}To achieve this, MiniVan offers various views of the network so that it becomes easy to perform visual and/or statistical analysis of it:{\textless}/p{\textgreater}{\textless}ul{\textgreater}  {\textless}li{\textgreater}Basemap of the spatialized graph{\textless}/li{\textgreater}  {\textless}li{\textgreater}Adjacency matrix{\textless}/li{\textgreater}  {\textless}li{\textgreater}Node list{\textless}/li{\textgreater}  {\textless}li{\textgreater}Various statistics{\textless}/li{\textgreater}  {\textless}li{\textgreater}etc.{\textless}/li{\textgreater}{\textless}/ul{\textgreater}{\textless}div class="vignette container\_vignette-block"{\textgreater}
              {\textless}input type="checkbox" id="focus-figure-4" name="focus-figure" hidden /{\textgreater}
              {\textless}label for="focus-figure-4" title="" arial-label=""{\textgreater}{\textless}/label{\textgreater}
              {\textless}figure class="vignette-block"{\textgreater}
                {\textless}img src="/static/minivan-stats\_332b0cb2-6d23-44d5-8504-e9ef4cd172fe.png" alt="View showing various statistics"/{\textgreater}{\textless}figcaption{\textgreater}View showing various statistics{\textless}/figcaption{\textgreater}
              {\textless}/figure{\textgreater}
            {\textless}/div{\textgreater}{\textless}p{\textgreater}Then, to ease the exploration of the network's many quantitative and qualitative values attached to nodes and edges, MiniVan proposes many ways to "dive" into the different modalities that can be found in the data.{\textless}/p{\textgreater}{\textless}div class="vignette container\_vignette-block"{\textgreater}
              {\textless}input type="checkbox" id="focus-figure-6" name="focus-figure" hidden /{\textgreater}
              {\textless}label for="focus-figure-6" title="" arial-label=""{\textgreater}{\textless}/label{\textgreater}
              {\textless}figure class="vignette-block"{\textgreater}
                {\textless}img src="/static/minivan-dive\_e0f09132-09f8-478e-a6d1-0503a7cf67d6.png" alt="Diving into the network's categories"/{\textgreater}{\textless}figcaption{\textgreater}Diving into the network's categories{\textless}/figcaption{\textgreater}
              {\textless}/figure{\textgreater}
            {\textless}/div{\textgreater}{\textless}p{\textgreater}What's more, once the network is published, it becomes possible to integrate views of the application directly within articles in order to enable the resitution of insights found through analysis.{\textless}/p{\textgreater}{\textless}p{\textgreater}Finally, MiniVan lets its users print any of its views very easily so one can use them to show results or even use them as teaching material.{\textless}/p{\textgreater}{\textless}div class="vignette container\_vignette-block"{\textgreater}
              {\textless}input type="checkbox" id="focus-figure-9" name="focus-figure" hidden /{\textgreater}
              {\textless}label for="focus-figure-9" title="" arial-label=""{\textgreater}{\textless}/label{\textgreater}
              {\textless}figure class="vignette-block"{\textgreater}
                {\textless}img src="/static/minivan-print\_1c9e072a-3a36-404a-a52d-d93170a09c87.png" alt="Print view"/{\textgreater}{\textless}figcaption{\textgreater}Print view{\textless}/figcaption{\textgreater}
              {\textless}/figure{\textgreater}
            {\textless}/div{\textgreater}},
	urldate = {2023-12-07},
	author = {Meunier, Guillaume Plique, Robin de Mourat, Arnaud Pichon, Axel, Mathieu Jacomy},
	month = mar,
	year = {2018},
	note = {Language: en},
}

@misc{mazoyer_pimmi_2022,
	title = {pimmi},
	url = {https://medialab.sciencespo.fr/en/tools},
	abstract = {{\textless}p{\textgreater}PIMMI is a software that performs visual mining in a corpus of images. Its main objective is to find all copies, total or partial, in large volumes of images and to group them together. Our initial goal is to study the reuse of images on social networks (typically, our first use is the propagation of memes on Twitter). However, we believe that its use can be much wider and that it can be easily adapted for other studies. The main features of PIMMI are therefore :{\textless}/p{\textgreater}{\textless}ul{\textgreater}  {\textless}li{\textgreater}ability to process large image corpora, up to several millions files{\textless}/li{\textgreater}  {\textless}li{\textgreater}be robust to some modifications of the images, typical of their reuse on social networks (crop, zoom, composition, addition of text, ...){\textless}/li{\textgreater}  {\textless}li{\textgreater}be flexible enough to adapt to different use cases (mainly the nature and volume of the image corpora){\textless}/li{\textgreater}{\textless}/ul{\textgreater}{\textless}figure class="illustration"{\textgreater}
              {\textless}img src="/static/pimmi\_3807bd55-d2f8-4a47-9986-55d1e94c33fa.png" alt="An example of pimmi's UI"/{\textgreater}{\textless}figcaption{\textgreater}An example of pimmi's UI{\textless}/figcaption{\textgreater}
            {\textless}/figure{\textgreater}{\textless}p{\textgreater}PIMMI is currently only focused on visual mining and therefore does not manage metadata related to images. The latter are specific to each study and are therefore outside our scope. Thus, a study using PIMMI will generally be broken down into several steps:{\textless}/p{\textgreater}{\textless}ol{\textgreater}  {\textless}li{\textgreater}constitution of a corpus of images (jpg and/or png files) and their metadata{\textless}/li{\textgreater}  {\textless}li{\textgreater}choice of PIMMI parameters according to the criteria of the corpus{\textless}/li{\textgreater}  {\textless}li{\textgreater}indexing the images with PIMMI and obtaining clusters of reused images{\textless}/li{\textgreater}  {\textless}li{\textgreater}exploitation of the clusters by combining them with the descriptive metadata of the images{\textless}/li{\textgreater}{\textless}/ol{\textgreater}{\textless}p{\textgreater}PIMMI relies on existing technologies and integrates them into a simple data pipeline:{\textless}/p{\textgreater}{\textless}ol{\textgreater}  {\textless}li{\textgreater}Use well-established local image descriptors (Scale Invariant Feature Transform: SIFT) to represent images as sets of keypoints. Geometric consistency verification is also used. ({\textless}a href="https://opencv.org/" target="\_blank" rel="noopener noreferrer"{\textgreater}OpenCV{\textless}/a{\textgreater} implementation for both).{\textless}/li{\textgreater}  {\textless}li{\textgreater}To adapt to large volumes of images, it relies on a well known vectors indexing library that provides some of the most efficient algorithms implementations ({\textless}a href="https://github.com/facebookresearch/faiss" target="\_blank" rel="noopener noreferrer"{\textgreater}FAISS{\textless}/a{\textgreater}) to query the database of keypoints.{\textless}/li{\textgreater}  {\textless}li{\textgreater}Similar images are grouped together using standard community detection algorithms on the graph of similarities.{\textless}/li{\textgreater}{\textless}/ol{\textgreater}{\textless}p{\textgreater}PIMMI is a library developed in Python, which can be used through a command line interface. It is multithreaded. A rudimentary web interface to visualize the results is also provided, but more as an example than for intensive use ({\textless}a href="https://github.com/nrv/pimmi-ui" target="\_blank" rel="noopener noreferrer"{\textgreater}Pimmi-ui{\textless}/a{\textgreater}).{\textless}/p{\textgreater}{\textless}p{\textgreater}The development of this software is still in progress : we warmly welcome beta-testers, feedback, proposals for new features and even pull requests !{\textless}/p{\textgreater}},
	urldate = {2023-12-07},
	author = {Mazoyer, Béatrice, Nicolas Hervé},
	year = {2022},
	note = {Language: en},
}

@misc{kirillov_segment_2023,
	title = {Segment {Anything}},
	url = {http://arxiv.org/abs/2304.02643},
	doi = {10.48550/arXiv.2304.02643},
	abstract = {We introduce the Segment Anything (SA) project: a new task, model, and dataset for image segmentation. Using our efficient model in a data collection loop, we built the largest segmentation dataset to date (by far), with over 1 billion masks on 11M licensed and privacy respecting images. The model is designed and trained to be promptable, so it can transfer zero-shot to new image distributions and tasks. We evaluate its capabilities on numerous tasks and find that its zero-shot performance is impressive -- often competitive with or even superior to prior fully supervised results. We are releasing the Segment Anything Model (SAM) and corresponding dataset (SA-1B) of 1B masks and 11M images at https://segment-anything.com to foster research into foundation models for computer vision.},
	urldate = {2023-12-07},
	publisher = {arXiv},
	author = {Kirillov, Alexander and Mintun, Eric and Ravi, Nikhila and Mao, Hanzi and Rolland, Chloe and Gustafson, Laura and Xiao, Tete and Whitehead, Spencer and Berg, Alexander C. and Lo, Wan-Yen and Dollár, Piotr and Girshick, Ross},
	month = apr,
	year = {2023},
