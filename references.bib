	annote = {Export Date: 01 July 2025; Cited By: 39; Correspondence Address: M. Hu; Wenzhou University, Wenzhou City, Chashan Street, Chashan District, Zhejiang Province, China; email: humingjun0918@126.com; J. Hu; Yulan Court Four, Guizhou University of Finance and Economics, Guiyang City, Huaxi District, Guizhou Province, China; email: hujin\_scholar@163.com; CODEN: JEVMA},
