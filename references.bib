	issn = {2210-4224},
	shorttitle = {Forever stuck in old ways?},
	url = {https://www.sciencedirect.com/science/article/pii/S2210422419302709},
	doi = {10.1016/j.eist.2019.10.012},
	abstract = {In this Viewpoint, we argue that transitions research needs to engage more firmly with the role of incumbents and various forms of incumbencies. We identify shortcomings of existing research, notably a tendency to portray incumbents as ‘villains’ wedded to resisting, slowing down or preventing transition efforts. With that in mind, the Viewpoint briefly summarises shortcomings within existing research and proposes four steps for pluralising the discussion. We call attention to more emphasis on 1) a multiplicity of incumbent actor types, 2) a variety of actor strategies within (and across) organisational populations, 3) the transient nature of strategic positioning (over time), and 4) the varied resources that incumbents may deploy to support transformative change.},
	urldate = {2023-12-10},
